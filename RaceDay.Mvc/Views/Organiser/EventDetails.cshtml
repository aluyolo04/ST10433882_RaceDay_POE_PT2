@model RaceDay.Mvc.Models.EventDetailsViewModel

@{
    ViewData["Title"] = "Manage Event";
}

<div class="container py-5">
    <a asp-action="Dashboard" class="btn btn-outline-secondary mb-3">
        Back to Dashboard
    </a>

    <h1 class="fw-bold">@Model.Event.EventName</h1>
    <p class="text-muted">
        @Model.Event.Location |
        @Model.Event.EventDate?.ToString("dd MMM yyyy")
    </p>

    <div class="card shadow-sm p-4 mb-4">
        <h3>Add Race Category</h3>

        <form asp-action="AddCategory"
              asp-route-eventId="@Model.Event.EventId" method="post">

            <div class="row g-3">
                <div class="col-md-6">
                    <label>Category Name</label>
                    <input name="CategoryName" class="form-control"
                           placeholder="e.g. 10km Open" required />
                </div>

                <div class="col-md-6">
                    <label>Distance (km)</label>
                    <input name="DistanceKm" type="number" step="0.01"
                           min="0.01" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label>Entry Fee (R)</label>
                    <input name="EntryFee" type="number" step="0.01"
                           min="0" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label>Maximum Participants</label>
                    <input name="MaxParticipants" type="number"
                           min="1" class="form-control"
                           value="100" required />
                </div>
            </div>

            <button class="btn btn-raceday mt-3">
                Add Category
            </button>
        </form>
    </div>

    <h3>Event Categories</h3>

    <div class="table-responsive">
        <table class="table table-hover bg-white">
            <thead class="table-dark">
                <tr>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Fee</th>
                    <th>Enrolled</th>
                    <th>Participants</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {

                <td>
                    <a asp-action="EditCategory"
                       asp-route-id="@category.CategoryId"
                       asp-route-eventId="@Model.Event.EventId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form asp-action="DeleteCategory"
                          asp-route-id="@category.CategoryId"
                          asp-route-eventId="@Model.Event.EventId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Delete this category and all its enrolments and results?');">

                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>

                    <tr>
                        <td>@category.CategoryName</td>
                        <td>@category.DistanceKm km</td>
                        <td>R @category.EntryFee.ToString("N2")</td>
                        <td>
                            @category.EnrolmentCount /
                            @category.MaxParticipants
                        </td>
                        <td>
                            <a asp-action="Enrolments"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-primary">
                                View Enrolments
                            </a>
                            <a asp-action="CaptureResults"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-sm btn-raceday mt-1">
                                Capture Results
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
