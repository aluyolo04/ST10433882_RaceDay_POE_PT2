@model RaceDay.Mvc.Models.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Organiser Dashboard</h1>
            <p class="text-muted">Manage your races and events.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-raceday">
            + Create Event
        </a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm">
                <h5>Total Events</h5>
                <h2 class="fw-bold">@Model.TotalEvents</h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4 shadow-sm">
                <h5>Upcoming Events</h5>
                <h2 class="fw-bold">@Model.UpcomingEvents</h2>
            </div>
        </div>
    </div>

    <h3 class="fw-bold mb-3">My Events</h3>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            You haven't created any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        <tr>
                            <td>@ev.EventName</td>
                            <td>@ev.EventDate?.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td>@ev.EventType</td>
                            <td>
                                <a asp-action="EventDetails"
                                   asp-route-id="@ev.EventId"
                                   class="btn btn-sm btn-primary">Manage</a>

                                <a asp-action="EditEvent"
                                   asp-route-id="@ev.EventId"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <form asp-action="DeleteEvent"
                                      asp-route-id="@ev.EventId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">
                                    <button class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
