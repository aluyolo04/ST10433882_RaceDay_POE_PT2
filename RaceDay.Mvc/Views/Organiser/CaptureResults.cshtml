@model List<RaceDay.Mvc.Models.EnrolmentViewModel>
@using RaceDay.Mvc.Models

@{
    ViewData["Title"] = "Capture Race Results";

    var results = ViewBag.Results as List<RaceResultViewModel>
        ?? new List<RaceResultViewModel>();

    int categoryId = (int)ViewBag.CategoryId;
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Capture Race Results</h1>
        <p class="text-muted">
            Enter finishing times, positions and participant statuses.
        </p>
    </div>

    <div class="card shadow-sm p-4">

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Status</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var participant in Model)
                    {
                        var existing = results.FirstOrDefault(
                        r => r.EnrolmentId == participant.EnrolmentId);

                        var formId = $"result-{participant.EnrolmentId}";

                        <tr>
                            <td>
                                <strong>@participant.ParticipantName</strong>
                            </td>

                            <td>
                                <input form="@formId"
                                       name="FinishTime"
                                       type="text"
                                       value="@existing?.FinishTime"
                                       placeholder="00:45:30"
                                       pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}"
                                       title="Use HH:mm:ss"
                                       class="form-control"
                                       style="min-width:125px" />
                            </td>

                            <td>
                                <input form="@formId"
                                       name="Position"
                                       type="number"
                                       min="1"
                                       value="@existing?.Position"
                                       class="form-control"
                                       style="min-width:85px" />
                            </td>

                            <td>
                                <select form="@formId"
                                        name="Status"
                                        class="form-select"
                                        style="min-width:125px">
                                    @foreach (var status in new[]
                                                                    {
                                                                "Finished", "DNF", "DNS", "DSQ"
                                                                })
                                    {
                                        <option value="@status"
                                                selected="@(existing?.Status == status)">
                                            @status
                                        </option>
                                    }
                                </select>
                            </td>

                            <td>
                                <form id="@formId"
                                      asp-action="SaveResult"
                                      method="post">
                                    <input type="hidden"
                                           name="EnrolmentId"
                                           value="@participant.EnrolmentId" />

                                    <input type="hidden"
                                           name="CategoryId"
                                           value="@categoryId" />

                                    <button type="submit"
                                            class="btn btn-raceday">
                                        Save
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No participants have enrolled in this category yet.
            </div>
        }
    </div>

    <div class="mt-4">
        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>
</div>
