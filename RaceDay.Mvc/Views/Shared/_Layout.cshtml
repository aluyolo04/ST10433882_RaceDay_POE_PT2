
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark raceday-nav">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home" asp-action="Index">
                RACEDAY<span class="brand-dot">.</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    @if (Context.Session.GetString("Role") == "Organiser")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Organiser"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>
                    }

                    @if (Context.Session.GetString("Role") == "Participant")
                    {

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="MyEnrolments">
                                My Enrolments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="MyResults">
                                My Results
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="Profile">
                                My Profile
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="Index">
                                My Dashboard
                            </a>
                        </li>
                    }

                    @if (!string.IsNullOrEmpty(
                                        Context.Session.GetString("Token")))
                    {
                        <li class="nav-item">
                            <span class="nav-link">
                                Hi, @Context.Session.GetString("FullName")
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout" method="post">
                                <button type="submit"
                                        class="btn btn-outline-light ms-lg-2">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-raceday ms-lg-2"
                               asp-controller="Account"
                               asp-action="Register">
                                Join RaceDay
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <main>

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="raceday-footer">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year RaceDay.
                Every race has a story.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
